{
  "name": "squad-six",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @squad-six/web dev",
    "build": "pnpm --filter @squad-six/web build",
    "start": "pnpm --filter @squad-six/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @squad-six/web test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "scoring:simulate": "node scripts/scoring-simulation.mjs"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  }
}
