{
  "expo": {
    "name": "Squad Six",
    "slug": "squad-six",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "squadsix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.squadsix.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071E15",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.squadsix.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071E15",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Squad Six uses your location during outdoor workouts to measure distance and pace. Your exact location is never shown to other people.",
          "locationAlwaysAndWhenInUsePermission": "Squad Six keeps measuring your outdoor workout while your phone is locked or another app is open. Location is only used during a workout you started.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "Squad Six keeps measuring your outdoor workout while your phone is locked or another app is open. Location is only used during a workout you started."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Squad Six uses motion data during a workout to confirm movement, like steps and cadence."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Squad Six reads workouts and heart rate from Apple Health to verify the workouts you log. It never sells or advertises with this data.",
          "NSHealthUpdateUsageDescription": "Squad Six only reads from Apple Health to verify your workouts. It never saves anything to Apple Health.",
          "background": false
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.578612999066-rb49b7205qsndodfm4keg7njcudm86g5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7761527c-6a8a-461b-bf3e-76da1c070d6f"
      }
    },
    "owner": "cndigital"
  }
}
