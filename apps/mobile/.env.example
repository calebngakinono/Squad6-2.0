# Copy to .env.local. EXPO_PUBLIC_* values are compiled into the app: never put a secret here.
# On a physical phone, 127.0.0.1 is the phone itself: use your Mac's LAN IP (e.g. http://192.168.1.20:25321)
# with `pnpm db:start` running, or the staging project's URL and publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:25321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
